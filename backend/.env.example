# Copie para .env e ajuste com os dados do seu MySQL
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=poupee
# MySQL na nuvem (Aiven etc.): DB_SSL=true e, se o provedor der um certificado, cole em DB_SSL_CA
DB_SSL=false
DB_SSL_CA=
# Endereço do front que pode chamar a API (* = qualquer um)
CORS_ORIGEM=*
# Segredo usado para assinar os tokens de login (qualquer texto longo e aleatório)
JWT_SEGREDO=troque-por-um-texto-longo-e-aleatorio

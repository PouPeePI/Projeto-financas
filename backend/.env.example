# Copie para .env e ajuste com os dados do seu PostgreSQL
PORT=3000
# Neon (ou outro Postgres na nuvem): cole o endereço completo de conexão
# DATABASE_URL=postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
# Postgres local (usado quando DATABASE_URL não está definido)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=poupee
# Endereço do front que pode chamar a API (* = qualquer um)
CORS_ORIGEM=*
# Segredo usado para assinar os tokens de login (qualquer texto longo e aleatório)
JWT_SEGREDO=troque-por-um-texto-longo-e-aleatorio
